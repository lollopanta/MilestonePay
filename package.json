{
  "name": "milestonepay",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "contracts:export": "pnpm --dir packages/contracts export",
    "api:sync": "pnpm --filter @milestonepay/api sync",
    "contracts:sync-fuji": "pnpm contracts:export && pnpm --dir packages/contracts sync-fuji"
  }
}
