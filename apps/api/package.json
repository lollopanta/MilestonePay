{
  "name": "@milestonepay/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env --import tsx src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "lint": "eslint .",
    "test": "node --import tsx --test src/*.test.ts src/**/*.test.ts",
    "sync": "node --env-file-if-exists=../../.env --import tsx src/indexer/cli.ts"
  },
  "dependencies": {
    "@milestonepay/evidence": "workspace:*",
    "@milestonepay/reputation": "workspace:*",
    "@arkiv-network/sdk": "0.8.0",
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.12.3",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
